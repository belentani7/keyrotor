# ============================================================
# keyrotor - environment template (PLACEHOLDERS ONLY)
# Copy to .env and fill with YOUR real keys. .env is gitignored.
# NEVER commit real keys to git.
# ============================================================

# --- Google AI Studio (Gemini) ---
# Keys separated by comma. Auth: query param ?key=
GOOGLE_API_KEYS=AIzaEXAMPLE_KEY_ONE,AIzaEXAMPLE_KEY_TWO
GOOGLE_MODEL=gemini-3.6-flash

# --- NVIDIA NIM (OpenAI-compatible) ---
NVIDIA_API_KEYS=nvapi-EXAMPLE_KEY_ONE,nvapi-EXAMPLE_KEY_TWO
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- OpenRouter ---
OPENROUTER_API_KEYS=sk-or-v1-EXAMPLE_KEY_ONE,sk-or-v1-EXAMPLE_KEY_TWO
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- OpenCode Zen (OpenAI-compatible) ---
OPENCODE_API_KEYS=sk-EXAMPLE_KEY_ONE
OPENCODE_MODEL=gpt-4o-mini
# Optional: override default endpoint
# OPENCODE_BASE_URL=https://your-zen-endpoint/v1/chat/completions

# --- Router behaviour ---
# KEYROTOR_PROVIDER_ORDER=openrouter,nvidia,google,opencode
# KEYROTOR_CACHE_TTL=300
# KEYROTOR_MAX_RETRIES=3
# KEYROTOR_BACKOFF=0.5
# KEYROTOR_BREAKER_THRESHOLD=5
# KEYROTOR_BREAKER_COOLDOWN=60
# KEYROTOR_PORT=8000
